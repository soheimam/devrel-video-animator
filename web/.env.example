# Who may use the app: one shared passcode (numbers are fine). Rotate it any time.
APP_PASSCODE=
# Signs the login cookie. Any long random string.
AUTH_SECRET=
# One key for everything: transcription and the agent both go through the AI Gateway.
AI_GATEWAY_API_KEY=
# Set automatically when a Blob store is linked to the Vercel project. Leave empty locally
# to use .jobs/ on disk instead.
BLOB_READ_WRITE_TOKEN=
# Which model the agent uses (an AI Gateway model id).
AGENT_MODEL=anthropic/claude-opus-5.5
# Where the Sandbox clones the pipeline from, and which revision. Defaults to this repo and
# the commit being deployed.
REPO_URL=https://github.com/soheimam/devrel-video-animator.git
# REPO_REVISION=main
# Locally: run jobs as a child process instead of a Vercel Sandbox.
LOCAL_RUNNER=1
