# Copy to .env and fill in ONE key. .env is git-ignored.
#
# Transcription runs through the Vercel AI SDK (ai-sdk.dev/docs/ai-sdk-core/transcription):
# one request to a hosted provider, word-level timestamps, nothing to download.

# Which provider to use: openai (default), deepgram, or gateway (Vercel AI Gateway)
TRANSCRIBE_PROVIDER=openai

# Model id. Defaults: whisper-1 (openai), nova-3 (deepgram), openai/whisper-1 (gateway)
# TRANSCRIBE_MODEL=whisper-1

# Keys: only the one for TRANSCRIBE_PROVIDER is needed
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
AI_GATEWAY_API_KEY=
