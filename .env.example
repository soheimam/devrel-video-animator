# Copy to .env and set ONE key. .env is git-ignored.
#
# Transcription runs through the Vercel AI SDK (ai-sdk.dev/docs/ai-sdk-core/transcription):
# one request to a hosted provider, word-level timestamps, nothing to download.
# The provider is picked from whichever key you set.

# Vercel AI Gateway: one key for every model (recommended)
AI_GATEWAY_API_KEY=

# Or a provider directly
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Only needed if you set more than one key: gateway | openai | deepgram
# TRANSCRIBE_PROVIDER=gateway

# Model id. Defaults: openai/whisper-1 (gateway), whisper-1 (openai), nova-3 (deepgram)
# TRANSCRIBE_MODEL=
