# Copy to .env and fill in ONE provider's key. .env is git-ignored.
#
# Transcription runs through the Vercel AI SDK (ai-sdk.dev/docs/ai-sdk-core/transcription):
# one request to a hosted provider, word-level timestamps, nothing to download.

# Which provider to use: openai (default) or deepgram
TRANSCRIBE_PROVIDER=openai

# Model id. Defaults: whisper-1 (openai), nova-3 (deepgram)
# TRANSCRIBE_MODEL=whisper-1

# Provider keys (only the one for TRANSCRIBE_PROVIDER is needed)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
